<Window x:Class="RecolorWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RecolorWpf"
        Title="Cluster Recolor Tool"
        Width="1100" Height="650"
        Background="#1B1B1C"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>

        <!-- Photoshop-style panel -->
        <Style x:Key="PsPanel" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12"
                                      ShadowDepth="0"
                                      Opacity="0.35"
                                      Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section header -->
        <Style x:Key="PsHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="0 0 0 8"/>
        </Style>

        <!-- Modern button -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#66000000"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBoxItem styling -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter Margin="4"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A86FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A86FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F2F33"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <DockPanel Grid.Row="0" Margin="0 0 0 10">
            <TextBlock Text="Cluster Recolor Tool"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#E0E0E0"
                       VerticalAlignment="Center"
                       Margin="10 0"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Load Image" Click="BtnLoad_Click"/>
                <Button x:Name="BtnSave" Content="Save" Click="BtnSave_Click" IsEnabled="False"/>
            </StackPanel>
        </DockPanel>

        <!-- Main layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Original Panel -->
            <Border Style="{StaticResource PsPanel}" Grid.Column="0">
                <StackPanel>
                    <TextBlock Text="Original" Style="{StaticResource PsHeader}"/>
                    <Image x:Name="ImgOriginal"
                           Stretch="Uniform"
                           MaxWidth="350"
                           MaxHeight="350"/>
                </StackPanel>
            </Border>

            <!-- Preview Panel -->
            <Border Style="{StaticResource PsPanel}" Grid.Column="1">
                <StackPanel>
                    <TextBlock Text="Preview" Style="{StaticResource PsHeader}"/>
                    <Image x:Name="ImgPreview"
                           Stretch="Uniform"
                           MaxWidth="350"
                           MaxHeight="350"/>
                </StackPanel>
            </Border>

            <!-- Right Sidebar -->
            <Border Style="{StaticResource PsPanel}" Grid.Column="2">
                <StackPanel>

                    <TextBlock Text="Clusters" Style="{StaticResource PsHeader}"/>

                    <ListBox x:Name="ClusterList"
                             Height="300">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ClusterViewModel}">
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <!-- Original color -->
                                    <Rectangle Width="24" Height="24"
                                               Stroke="#444"
                                               StrokeThickness="1"
                                               RadiusX="4" RadiusY="4"
                                               Fill="{Binding OriginalBrush}"/>

                                    <!-- New editable color -->
                                    <Rectangle Width="24" Height="24"
                                               Stroke="#444"
                                               StrokeThickness="1"
                                               RadiusX="4" RadiusY="4"
                                               Margin="8 0 0 0"
                                               Fill="{Binding NewBrush}"
                                               MouseLeftButtonUp="ClusterNewColor_Click"/>

                                    <!-- Hex label -->
                                    <TextBlock Text="{Binding Hex}"
                                               Foreground="White"
                                               Margin="10 0 0 0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Separator Margin="0 10"/>

                    <TextBlock Text="Tip: click the right color to recolor that cluster."
                               Foreground="#AAAAAA"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </Border>

        </Grid>

    </Grid>

</Window>
